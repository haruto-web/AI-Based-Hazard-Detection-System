rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isHeadOffice() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'Safety Engineer - Head Office',
          'Safety Manager - Head Office',
          'HSE Head - Head Office'
        ];
    }

    function isHSEHead() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'HSE Head - Head Office';
    }

    // --- MOBILE APP COMPATIBLE RULES (No Firebase Auth Required) ---

    match /mobile_accounts/{accountId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isHSEHead();
    }

    match /messages/{messageId} {
      // Updated to allow delete for mobile app cleanup features
      allow create, read, update, delete: if true;
    }

    match /incidents/{incidentId} {
      // Updated to allow delete for removing resolved/done incidents from mobile
      allow read, create, update, delete: if true;
    }

    match /detections/{detectionId} {
      // Allow mobile app to show recent detections.
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /audit_logs/{logId} {
      // Allow app to log actions.
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // --- WEBSITE / AUTHENTICATED ACCESS ---

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isHeadOffice();

      match /notifications/{notifId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /incidents/{incidentId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isHeadOffice();
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isHeadOffice();
    }

    match /camera_configs/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
