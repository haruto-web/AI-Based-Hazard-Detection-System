rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isHeadOffice() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'Safety Engineer - Head Office',
          'Safety Manager - Head Office',
          'HSE Head - Head Office'
        ];
    }

    function isHSEHead() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'HSE Head - Head Office';
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isValidUserRole(role) {
      return role in [
        'Site Safety Officer',
        'Site Safety Practitioner',
        'Site Project Engineer',
        'Site Construction Manager',
        'Safety Engineer - Head Office',
        'Safety Manager - Head Office',
        'HSE Head - Head Office'
      ];
    }

    // --- MOBILE APP COMPATIBLE RULES (No Firebase Auth Required) ---

    match /mobile_accounts/{accountId} {
      allow read: if true;
      allow update: if true;
      allow create: if isHSEHead() || (
        isAdmin() &&
        accountId == request.resource.data.authUid &&
        request.resource.data.keys().hasAll([
          'name', 'role', 'username', 'usernameLowercase', 'email', 'authUid',
          'site', 'status', 'mobileSetupStatus', 'linkedWebsiteUid',
          'createdBy', 'createdByEmail', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name', 'role', 'username', 'usernameLowercase', 'email', 'authUid',
          'site', 'status', 'mobileSetupStatus', 'linkedWebsiteUid',
          'createdBy', 'createdByEmail', 'createdAt'
        ]) &&
        request.resource.data.authUid == accountId &&
        request.resource.data.linkedWebsiteUid == accountId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'active' &&
        request.resource.data.mobileSetupStatus == 'setup_required' &&
        getAfter(/databases/$(database)/documents/users/$(accountId)).data.approvalStatus == 'approved' &&
        (
          get(/databases/$(database)/documents/users/$(accountId)).data.approvalStatus == 'approved' ||
          getAfter(/databases/$(database)/documents/users/$(accountId)).data.reviewedBy == request.auth.uid
        ) &&
        getAfter(/databases/$(database)/documents/users/$(accountId)).data.email == request.resource.data.email &&
        getAfter(/databases/$(database)/documents/users/$(accountId)).data.role == request.resource.data.role &&
        getAfter(/databases/$(database)/documents/users/$(accountId)).data.site == request.resource.data.site
      );
      allow delete: if isHSEHead();
    }

    match /messages/{messageId} {
      // Updated to allow delete for mobile app cleanup features
      allow create, read, update, delete: if true;
    }

    match /incidents/{incidentId} {
      // Updated to allow delete for removing resolved/done incidents from mobile
      allow read, create, update, delete: if true;
    }

    match /detections/{detectionId} {
      // Allow mobile app to show recent detections.
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /audit_logs/{logId} {
      // Allow app to log actions.
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // --- WEBSITE / AUTHENTICATED ACCESS ---

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.approvalStatus == 'pending' &&
        request.resource.data.role == null;
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'email', 'phone', 'cameraIP', 'cameras', 'lastLogin', 'site'
        ]) || (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['site']) &&
          request.resource.data.site is string &&
          request.resource.data.site.size() <= 120
        ) || (
          isAdmin() &&
          resource.data.approvalStatus == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvalStatus', 'role', 'site', 'reviewedAt', 'reviewedBy'
          ]) &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.reviewedAt == request.time &&
          (
            (
              request.resource.data.approvalStatus == 'approved' &&
              isValidUserRole(request.resource.data.role) &&
              request.resource.data.site is string &&
              request.resource.data.site.size() > 0 &&
              (!(request.resource.data.role in [
                'Safety Engineer - Head Office',
                'Safety Manager - Head Office',
                'HSE Head - Head Office'
              ]) || isSuperAdmin())
            ) || (
              request.resource.data.approvalStatus == 'rejected' &&
              request.resource.data.role == null
            )
          )
        );
      allow delete: if isAdmin() &&
        userId != request.auth.uid &&
        resource.data.email != 'mirasolvenandrew@gmail.com';

      match /notifications/{notifId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if (isSignedIn() && request.auth.uid == userId) || (
          isAdmin() &&
          request.resource.data.keys().hasOnly([
            'type', 'violationType', 'cameraSource', 'role', 'read', 'timestamp'
          ]) &&
          request.resource.data.read == false &&
          request.resource.data.timestamp == request.time &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.reviewedBy == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.reviewedAt == request.time &&
          (
            (
              request.resource.data.type == 'account_approved' &&
              getAfter(/databases/$(database)/documents/users/$(userId)).data.approvalStatus == 'approved' &&
              request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(userId)).data.role &&
              isValidUserRole(request.resource.data.role)
            ) || (
              request.resource.data.type == 'account_rejected' &&
              getAfter(/databases/$(database)/documents/users/$(userId)).data.approvalStatus == 'rejected' &&
              request.resource.data.role == null &&
              getAfter(/databases/$(database)/documents/users/$(userId)).data.role == null
            )
          )
        );
      }

      match /incidents/{incidentId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isHeadOffice();
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isHeadOffice();
    }

    match /camera_configs/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
